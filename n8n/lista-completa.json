    {
      "parameters": {
        "jsCode": "const body = $('Webhook').first().json.body || {};\nconst r = body.rodada || {};\nconst tz = 'America/Sao_Paulo';\nconst dataRodada = r.data\n  ? new Date(r.data + 'T12:00:00Z').toLocaleDateString('pt-BR', { weekday: 'long', day: '2-digit', month: '2-digit', timeZone: 'UTC' })\n  : '';\nconst horario = [r.horario_inicio, r.horario_fim].filter(Boolean).join(' às ');\n\nconst num = (n) => String(n).padStart(2, '0');\nconst nomeEvento = (r.nome_evento || 'SE PASSOU, É PONTO').toUpperCase();\nconst diaSemana = r.data\n  ? new Date(r.data + 'T12:00:00Z').toLocaleDateString('pt-BR', { weekday: 'long', timeZone: 'UTC' }).toUpperCase()\n  : '';\nconst dataCurta = r.data\n  ? new Date(r.data + 'T12:00:00Z').toLocaleDateString('pt-BR', { timeZone: 'UTC' })\n  : '';\nconst titulares = (body.jogadores || []).map((j) => num(j.posicao) + ' - ' + j.nome + (j.novo ? ' 🆕' : ''));\nconst reservas = (body.reservas || []).map((j) => num(j.posicao) + ' - ' + j.nome);\nconst sairam = body.sairam || [];\nconst entraram = body.entraram || [];\n\nconst linhas = [\n  '🏐 *' + nomeEvento + '*',\n  '📅 *' + diaSemana + ' — ' + dataCurta + '*',\n  '',\n  body.atualizacao ? '🔄 *LISTA ATUALIZADA*' : null,\n  sairam.length ? '❌ Saiu: ' + sairam.join(', ') : null,\n  entraram.length ? '⬆️ Entrou: ' + entraram.join(', ') : null,\n  body.atualizacao ? '' : null,\n  '✅ *TITULARES — ' + titulares.length + '/' + r.limite_lista + '*',\n  '',\n  ...titulares,\n  '',\n  '⏳ *RESERVA — ' + reservas.length + '*',\n  '',\n  ...(reservas.length ? reservas : ['Nenhum jogador na reserva.']),\n  '',\n  r.status === 'open' ? '🟢 *LISTA ABERTA*' : '🔴 *LISTA FECHADA*',\n].filter((l) => l !== null);\n\nreturn [{ json: { mensagem: linhas.join('\\n') } }];"
      },
      "id": "57d61980-c8d1-4057-ad66-71851930d10b",

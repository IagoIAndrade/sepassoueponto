    {
      "parameters": {
        "jsCode": "const body = $('Webhook').first().json.body || {};\nconst r = body.rodada || {};\n\nconst nomeEvento = (r.nome_evento || 'SE PASSOU, É PONTO').toUpperCase();\nconst diaSemana = r.data\n  ? new Date(r.data + 'T12:00:00Z').toLocaleDateString('pt-BR', { weekday: 'long', timeZone: 'UTC' }).toUpperCase()\n  : '';\nconst dataCurta = r.data\n  ? new Date(r.data + 'T12:00:00Z').toLocaleDateString('pt-BR', { timeZone: 'UTC' })\n  : '';\nconst horario = [r.horario_inicio, r.horario_fim].filter(Boolean).join(' às ');\nconst num = (n) => String(n).padStart(2, '0');\n\nconst mudancas = (body.mudancas || []).map((m) => {\n  if (m.para == null) return '❌ ' + m.nome + ' saiu do Time ' + m.de;\n  if (m.de == null) return '🆕 ' + m.nome + ' → Time ' + m.para;\n  return '🔁 ' + m.nome + ': Time ' + m.de + ' → Time ' + m.para;\n});\n\nconst blocosTimes = (body.times || []).flatMap((t) => [\n  '👕 *TIME ' + t.numero + '* (' + t.total + ')',\n  ...(t.jogadores || []).map((j) => num(j.posicao) + ' - ' + j.nome + (j.novo ? ' 🆕' : '')),\n  '',\n]);\n\nconst linhas = [\n  '🏐 *' + nomeEvento + '*',\n  '📅 *' + [diaSemana, dataCurta].filter(Boolean).join(' — ') + '*' + (horario ? ' ⏰ ' + horario : ''),\n  r.local ? '📍 ' + r.local : null,\n  '',\n  body.atualizacao ? '🔄 *TIMES ATUALIZADOS*' : '🎲 *TIMES SORTEADOS*',\n  ...(mudancas.length ? [...mudancas, ''] : ['']),\n  ...blocosTimes,\n  'Confira seu time no app. Bom jogo! 💪',\n].filter((l) => l !== null);\n\nreturn [{ json: { mensagem: linhas.join('\\n').trim() } }];\n"
      },
      "id": "b1b894b1-0374-417c-95bc-8817fb49fbbd",
      "name": "Montar mensagem",

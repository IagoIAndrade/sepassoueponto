    },
    {
      "parameters": {
        "jsCode": "const body = $('Webhook').first().json.body || {};\nconst r = body.rodada || {};\nconst turma = (r.turma || 'TURMA').toUpperCase();\nconst data = r.data ? new Date(r.data + 'T12:00:00Z').toLocaleDateString('pt-BR', { timeZone: 'UTC' }) : '';\nconst blocos = (body.times || []).map((t) =>\n  '*TIME ' + t.numero + '*\\n' + (t.jogadores || []).map((j, i) => (i + 1) + '. ' + String(j.nome).toUpperCase()).join('\\n')\n);\nconst listaTimes = blocos.join('\\n\\n');\n\nconst texto = [\n  '🛡️ *VALIDAÇÃO DOS TIMES — ' + turma + '*',\n  '📅 ' + data,\n  '',\n  listaTimes,\n  '',\n  '👀 Confiram os times e respondam aqui no grupo.',\n  'Se todos concordarem, os times serão enviados ao grupo dos jogadores.',\n].join('\\n');\nreturn [{ json: { mensagem: texto } }];"
      },
      "id": "c515e2d5-8888-4375-8f27-83de571a421a",
      "name": "Montar mensagem",

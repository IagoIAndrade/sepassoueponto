        660,
        120
      ]
    },
    {
      "parameters": {
        "jsCode": "const body = $('Webhook').first().json.body || {};\nconst r = body.rodada || {};\nconst turma = (r.turma || 'TURMA').toUpperCase();\nconst data = r.data ? new Date(r.data + 'T12:00:00Z').toLocaleDateString('pt-BR', { timeZone: 'UTC' }) : '';\nconst blocos = (body.times || []).map((t) =>\n  '*TIME ' + t.numero + '*\\n' + (t.jogadores || []).map((j, i) => (i + 1) + '. ' + String(j.nome).toUpperCase()).join('\\n')\n);\nconst listaTimes = blocos.join('\\n\\n');\n\nconst texto = '🏐 *SE PASSOU, É PONTO*\\n\\n*TIMES — ' + turma + '*\\n📅 ' + data + '\\n\\n' + listaTimes;\nreturn [{ json: { mensagem: texto } }];"
      },
      "id": "51a536ab-4573-46ad-95b4-a2ee34cde668",
      "name": "Montar mensagem",
      "type": "n8n-nodes-base.code",
